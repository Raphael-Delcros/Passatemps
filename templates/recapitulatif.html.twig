{% extends 'base_template.html.twig' %}
{% block title %}{{constantes.application.website_name}} - Récapitulatif {% endblock %}

{% block body %}

<div class="container mt-5 text-center">
<p>Adresse de livraison→ Paiement → <b>C'est bon !</b></p>

    <h1 class="big-checkmark mb-5">
        <i class="bi bi-check"></i>
    </h1>

    <p class="fs-5">
        Votre achat a bien été pris en compte
    </p>
    <div class="card mx-auto mt-4" style="max-width: 400px;">
        <div class="card-body">
            <p class="card-text">
                <strong>Jeu :</strong> {{ jeu.nom }} <br>
                <strong>Prix :</strong> {{ annonce.prix }} € <br>
                <strong>Annonce :</strong> {{ annonce.titre }} 
            </p>
        </div>
    </div>

    <a href="index.php" class="btn btn-primary mt-4">
        Retour à l’accueil
    </a>

</div>

{% endblock %}
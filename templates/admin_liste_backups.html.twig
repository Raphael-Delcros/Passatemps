{% extends 'base_template.html.twig' %}

{% block title %}Gestion des Sauvegardes{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Archives de la base de données</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nom du fichier</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for fichier in listeFichiers %}
                    <tr>
                        <td class="align-middle">
                            <i class="bi bi-file-earmark-code me-2"></i>{{ fichier }}
                        </td>
                        <td class="text-end">
                            <a href="index.php?controleur=admin&methode=restaurerBdd&file={{ fichier }}" 
                               class="btn btn-sm btn-primary"
                               onclick="return confirm('Attention : Cette action va écraser la base actuelle par le contenu de ce fichier. Continuer ?')">
                                <i class="bi bi-arrow-counterclockwise"></i> Restaurer
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="2" class="text-center text-muted">Aucune sauvegarde trouvée dans {{ backupPath }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
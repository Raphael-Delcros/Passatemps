{% extends "base_template.html.twig" %}
{% block title %}
	{{constantes.application.website_name}}
	- Gestion des commandes
{% endblock %}

{% block body %}
	<div class="container mt-5 ">
		<h1 class="text-center fw-bold">
			Vos Commandes
		</h1>
		<div class="card shadow-sm border-0">
			<div class="list-group list-group-flush rounded shadow-sm">

				{% if commandes is empty %}
					<div class="text-center p-5">
						<i class="bi bi-chat-square-dots text-muted fs-1"></i>
						<p class="mt-3 text-muted">Vous n'avez aucune commande pour le moment.</p>
					</div>
				{% else %}
					<div class="table-responsive">
						<table class="table table-striped">
							<thead class="table-dark">
								<tr>
									<th class="text-nowrap">Jeu commandé</th>
									<th class="text-nowrap">Date de la commande</th>
									<th class="text-nowrap">Numéro de suivi</th>
									<th class="text-nowrap">Prix</th>
									<th class="text-nowrap">Status</th>
									<th class="text-nowrap">Actions</th>
									<th class="text-nowrap">Notations</th>
								</tr>
							</thead>
							<tbody>
								{% for commande in commandes %}
									<tr>
										<td>
											<a href="index.php?controleur=Annonce&methode=afficher&id={{ commande.idAnnonce }}">{{ commande.titre }}</a>
										</td>
										<td>{{ commande.dateCommande|date('d/m/Y') }}</td>
										<td>{{ commande.numeroDeSuivi }}</td>
										<td class="text-nowrap">{{ commande.prix }}
											€</td>
										<td>{{ commande.status }}</td>
										<td class="text-nowrap">
											<a href="index.php?controleur=livraison&methode=afficher&id={{ commande.idLivraison }}" class="btn btn-primary btn-sm">Voir Détails</a>
										</td>

										



										{% if commande.status == 'livré' %} <!-- ATTENTION incompréhension car ça fonctionne pas ma commade n'est pas livrée mais le bonton fonctionne -->
											<td class="text-nowrap">

											<!-- Button No -->
											
											<button href="index.php?controleur=livraison&methode=afficher&id={{ commande.idLivraison }}" type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
											Noter
											</button>

											<!-- Modal -->
											<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
											<div class="modal-dialog" role="document">
												<div class="modal-content">
												<div class="modal-header">
													<h5 class="modal-title" id="exampleModalLabel">Noter le vendeur</h5>
													</button>
												</div>
												<div class="modal-body">
													<!-- Notation -->
													
													

													<div class="">
														<h2>{{nom}}{{prenom}} <!-- METTRE nom et prénom du vendeur--></h2>

														<label for="customRange2" class="form-label"></label>
														<input type="range" class="form-range" min=0 max=5 id="customRange2">
														<br>
														Note : 
														<output for="customRange2" id="rangeValue" aria-hidden="true"></output> / 5

														<!-- JS pour voir la note en dessous du range-->

														

													</div>
												</div>
												<div class="modal-footer">
													<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>

													<form method="POST" action="index.php?controleur=note&methode=insererLaNote" class="input-group">
														<input type="hidden" name="idLivraison" value="{{ commande.idLivraison }}">
														<input type="hidden" name="note" id="idNote">
														<button type="submit" class="btn btn-primary" data-bs-dismiss="modal">Enregistrer la note</button>
													</form>

												</div>
												</div>
											</div>
											</div>

												
											</td>
										{% else %}
											<td class="text-nowrap">
												<a href="index.php?controleur=livraison&methode=afficher&id={{ commande.idLivraison }}" class="btn btn-primary btn-sm" tabindex="-1" role="button" aria-disabled="true">Noter</a>
											</td>
										
										{% endif %}
										
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
	<script>
		// This is an example script, please modify as needed
	const rangeInput = document.getElementById('customRange2');
	const rangeOutput = document.getElementById('rangeValue');
	const note = document.getElementById('idNote');

	// Set initial value
	rangeOutput.textContent = rangeInput.value;
	note.value = 3;

	rangeInput.addEventListener('input', function() {
		rangeOutput.textContent = this.value;
		note.value = this.value;

	});
	</script>
{% endblock %}
